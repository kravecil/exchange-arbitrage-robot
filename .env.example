# Скопируйте файл в .env и заполните значения:  cp .env.example .env
# .env добавлен в .gitignore и НИКОГДА не должен попадать в репозиторий.

# ---------- Binance Futures ----------
BINANCE_API_KEY=
BINANCE_SECRET=

# ---------- Bybit ----------
BYBIT_API_KEY=
BYBIT_SECRET=

# ---------- OKX (нужна дополнительно passphrase) ----------
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=

# ---------- Gate.io ----------
GATE_API_KEY=
GATE_SECRET=

# ---------- Bitget ----------
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSWORD=

# ---------- Переопределение настроек (необязательно) ----------
# Путь к файлу конфигурации
# ARB_CONFIG=config.yaml
# Режим торговли: paper (тест) или live (реальные ордера)
ARB_MODE=paper
# ARB_LOG_LEVEL=INFO
# Порог входа по чистому спреду, %
# ARB_MIN_SPREAD=0.35
# ARB_MAX_SPREAD=5.0
# ARB_EXIT_SPREAD=0.05
# Объём одной ноги в USDT
# ARB_ORDER_AMOUNT=100
# ARB_MAX_POSITIONS=3

# Управление статусными сообщениями (необязательно)
# Включить вывод периодических статусных сообщений (по умолчанию true)
# ARB_ENABLE_STATUS_LOGGING=true
